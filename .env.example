# Supabase — каталог (чтение), нужны и локально, и в проде
# Есть дефолты в next.config.mjs (публичные ключи, безопасно хардкодить) —
# локально можно не задавать, но лучше держать явно в .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Prisma — write-операции (заказы, бронирования) и import-скрипты
DATABASE_URL=postgresql://user:password@localhost:5432/trak_db
DIRECT_URL=

NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_2=

# Optional: proxy for Telegram API — LOCAL DEVELOPMENT ONLY
# DO NOT set on Vercel/production — breaks Supabase HTTP requests for everything else
HTTPS_PROXY=
HTTP_PROXY=

# Basic Auth для эндпоинтов 1С (/api/products, /api/orders)
SYNC_LOGIN=
SYNC_PASSWORD=

# Не реализовано, зарезервировано на будущее
SMS_API_KEY=
